{
  "name": "portfolio-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack dev",
    "build": "tsrs --noEmit --fast --runExternalCode && rspack build --mode production",
    "preview": "rspack preview",
    "typecheck": "tsrs --noEmit --fast --runExternalCode",
    "lint": "oxlint",
    "cycles": "node tools/import-cycles.ts src e2e tools",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "rspack build --mode production && cucumber-js",
    "check": "pnpm typecheck && pnpm lint && pnpm cycles && pnpm fmt:check && pnpm test"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@formatjs/intl": "6.1.4",
    "@tsrx/oxc": "0.23.0",
    "octane": "0.16.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@octanejs/rspack-plugin": "0.2.8",
    "@octanejs/testing-library": "0.1.68",
    "@octanejs/vite-plugin": "0.5.0",
    "@playwright/test": "^1.64.1",
    "@rspack/cli": "2.3.1",
    "@rspack/core": "2.3.1",
    "@rspack/dev-server": "2.2.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@tsrx/content-mapper": "0.1.2",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "octane-tsrx-mapper": "link:tools/octane-tsrx-mapper",
    "oxc-minify": "0.157.0",
    "oxc-transform": "0.157.0",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2"
}
